# Jags model to fit logistic curves to sexual maturity-age relationships
# of Stenella with n.sp species (attenuata [1], coeruleoalba [2], and
# longirostris [3]). 


model {
	for (i in 1:N) {
		# Likelihood
		y[i] ~ dbern(p[i])
    
		# Reparameterized linear predictor!
		# X[i] is length, and L0 is directly the 50% maturity length.
		logit(p[i]) <- alpha + beta * (X[i])
	}
 
	alpha ~ dnorm(0, 0.001)
	beta ~ dnorm(0, 0.001)
	 
}

